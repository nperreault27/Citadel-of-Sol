# Normalise line endings so the repo stays consistent across Windows and CI.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.keystore binary
*.jks binary
*.aab binary
*.apk binary

# Generated; collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true
public/assets/tilemaps/overworld.json linguist-generated=true
